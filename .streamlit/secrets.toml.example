# Copy this file to .streamlit/secrets.toml and fill in your keys.
# .streamlit/secrets.toml is git-ignored and must never be committed.
#
# The app runs fully without any of these:
#   - no OPENWEATHER_API_KEY  -> clearly labelled demo weather
#   - no LLM_API_KEY          -> explanations come from the calculation engine
#                                (image assessment stays unavailable by design)

OPENWEATHER_API_KEY = ""

LLM_PROVIDER = "gemini"
LLM_API_KEY  = ""
LLM_MODEL    = "gemini-3.5-flash"
VISION_MODEL = "gemini-3.5-flash"
